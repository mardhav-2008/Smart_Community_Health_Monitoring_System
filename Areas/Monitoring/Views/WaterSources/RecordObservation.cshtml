@model WaterObservation
@{ ViewData["Title"] = "Record Observation"; }
<div class="container py-4"><h1>Record Observation</h1><form asp-action="RecordObservation" method="post" class="card card-body gap-3">
<input asp-for="WaterSourceId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div><label asp-for="Parameter" class="form-label"></label><input asp-for="Parameter" class="form-control" required placeholder="e.g. pH, turbidity, temperature"/></div>
<div class="row"><div class="col"><label asp-for="Value" class="form-label"></label><input asp-for="Value" class="form-control" type="number" step="any" required/></div><div class="col"><label asp-for="Unit" class="form-label"></label><input asp-for="Unit" class="form-control" required placeholder="e.g. pH, NTU, °C"/></div></div>
<div><label asp-for="ObservedAtUtc" class="form-label">Observed at (UTC)</label><input asp-for="ObservedAtUtc" class="form-control" type="datetime-local" value="@Model.ObservedAtUtc.ToString("yyyy-MM-ddTHH:mm")"/></div>
<button class="btn btn-primary">Save observation</button></form></div>
