@{
    ViewData["Title"] = "Community Health Monitoring";
}

<!-- =========================================
     HERO
     ========================================= -->

<section class="hero" id="home">

    <div class="hero-background"></div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <span class="eyebrow">
            COMMUNITY HEALTH INITIATIVE
        </span>

        <h1>
            Health begins with
            the water we share.
        </h1>

        <p>
            Bringing water intelligence and community health
            monitoring together to identify risks and support
            earlier warnings across rural communities.
        </p>

        <a href="#mission" class="btn-glass glass">
            Discover our mission
            <span>↗</span>
        </a>
    </div>

    <div class="hero-status glass">
        <div class="panel-heading">
            <div>
                <span class="panel-eyebrow">LIVE OVERVIEW</span>
                <h3>Community pulse</h3>
            </div>

            <span class="demo-tag">
                <span class="status-dot"></span>
                DEMO
            </span>
        </div>

        <div class="panel-divider"></div>

        <div class="status-row">
            <span class="status-icon">◉</span>
            <div>
                <span>Water monitoring</span>
                <strong>System ready</strong>
            </div>
            <span class="status-arrow">↗</span>
        </div>

        <div class="status-row">
            <span class="status-icon">⌖</span>
            <div>
                <span>Community health</span>
                <strong>Data collection</strong>
            </div>
            <span class="status-arrow">↗</span>
        </div>

        <div class="status-row">
            <span class="status-icon">⌁</span>
            <div>
                <span>Early warning</span>
                <strong>Standby</strong>
            </div>
            <span class="status-arrow">↗</span>
        </div>

        <div class="panel-divider"></div>

        <div class="panel-footer">
            <span>PROJECT STATUS</span>
            <span>PROTOTYPE PHASE</span>
        </div>
    </div>

    <div class="hero-caption">
        <span>WATER · HEALTH · COMMUNITY</span>
        <span>NORTHEAST INDIA</span>
    </div>

</section>


<!-- =========================================
     MISSION / CONTINUOUS IMAGE STORY
     ========================================= -->

<section class="story" id="mission">

    <div class="story-stage">

        <!-- Mission copy: visible at the beginning -->
        <div class="story-intro">

            <span class="section-eyebrow">
                01 — OUR PURPOSE
            </span>

            <h2>
                A healthier community begins with understanding
                <em>its environment.</em>
            </h2>

            <p>
                In rural communities, access to safe water and
                timely health information can make a meaningful
                difference. Yet environmental risks and emerging
                health patterns are often difficult to identify early.
            </p>

            <p>
                Our initiative brings environmental monitoring,
                community health information and early-warning
                capabilities together in one connected system.
            </p>

            <span class="story-scroll-hint">
                SCROLL TO EXPLORE
                <span>↓</span>
            </span>

        </div>


        <!-- ONE image. It expands into the next screen. -->
        <div class="story-image-frame">

            <img class="story-image"
                 src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=2000&q=90"
                 alt="Expansive natural landscape" loading="eager" />

            <div class="story-image-label glass">
                <span class="status-dot"></span>
                ENVIRONMENTAL AWARENESS
            </div>

        </div>


        <!-- Content that appears over the expanded image -->
        <div class="story-reveal">

            <span class="section-eyebrow">
                02 — OUR APPROACH
            </span>

            <h2>
                One connected view.
                <em>A healthier future.</em>
            </h2>

            <p>
                Understanding environmental conditions,
                recognizing health patterns, and bringing
                meaningful information together.
            </p>

            <a href="#approach" class="btn-glass glass">
                Discover our approach
                <span>↗</span>
            </a>

        </div>

        <div class="story-caption">
            <span>ENVIRONMENTAL INTELLIGENCE</span>
            <span>WATER · HEALTH · COMMUNITY</span>
        </div>

    </div>

</section>


<!-- =========================================
     THREE PILLARS
     ========================================= -->

<section class="pillars-section" id="approach">

    <div class="section-topline">
        <span>03 — THE THREE PILLARS</span>
        <span>A CONNECTED APPROACH</span>
    </div>

    <div class="pillars-heading">
        <span class="section-eyebrow">WHAT WE BRING TOGETHER</span>

        <h2>
            Three perspectives.
            <em>One shared purpose.</em>
        </h2>
    </div>

    <div class="pillars-grid">

        <article class="pillar-card">
            <span class="pillar-number">01</span>
            <span class="pillar-icon">◉</span>

            <h3>Water intelligence</h3>

            <p>
                Monitor water-related environmental indicators
                and identify potential quality concerns.
            </p>

            <span class="pillar-bottom">ENVIRONMENTAL DATA</span>
        </article>

        <article class="pillar-card">
            <span class="pillar-number">02</span>
            <span class="pillar-icon">⌖</span>

            <h3>Community health</h3>

            <p>
                Understand reported health patterns and identify
                emerging community-level concerns.
            </p>

            <span class="pillar-bottom">HEALTH INFORMATION</span>
        </article>

        <article class="pillar-card">
            <span class="pillar-number">03</span>
            <span class="pillar-icon">⌁</span>

            <h3>Early awareness</h3>

            <p>
                Bring relevant information together to support
                timely risk assessment and communication.
            </p>

            <span class="pillar-bottom">RISK COMMUNICATION</span>
        </article>

    </div>

</section>


<!-- =========================================
     MONITORING SECTION
     ========================================= -->

<section class="monitoring-section" id="monitoring">

    <div class="monitoring-copy">
        <span class="section-eyebrow">04 — THE PLATFORM</span>

        <h2>
            From scattered information
            to <em>shared understanding.</em>
        </h2>

        <p>
            A unified monitoring platform can help bring
            environmental observations and community health
            information into one place.
        </p>

        <p>
            The prototype is designed around collecting,
            organizing and interpreting information before
            communicating potential concerns.
        </p>

        <a href="#home" class="text-link">
            Return to overview <span>↗</span>
        </a>
    </div>

    <div class="monitoring-visual glass">

        <div class="visual-topline">
            <span>MONITORING FRAMEWORK</span>
            <span class="demo-tag">CONCEPT</span>
        </div>

        <div class="visual-orbit">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>

            <div class="orbit-center">
                <span>CH</span>
            </div>

            <span class="orbit-node node-one">W</span>
            <span class="orbit-node node-two">H</span>
            <span class="orbit-node node-three">A</span>
        </div>

        <div class="visual-legend">
            <span><i></i> Water observations</span>
            <span><i></i> Health information</span>
            <span><i></i> Early awareness</span>
        </div>

        <p class="visual-disclaimer">
            Conceptual system illustration — not live monitoring data.
        </p>

    </div>

</section>
