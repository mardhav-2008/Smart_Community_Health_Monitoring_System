<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Community Health Initiative</title>

    <meta name="theme-color" content="#172d29" />
    <meta name="description"
          content="Connecting environmental monitoring, community health information and early-warning capabilities for rural communities." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewContext.RouteData.Values["area"]?.ToString() == "Monitoring")
    {
        <link rel="stylesheet" href="~/css/monitoring.css" asp-append-version="true" />
    }
</head>

<body>
    <header class="site-header">
        <nav class="liquid-navbar glass app-navbar" aria-label="Main navigation">

            <a class="brand" asp-area="" asp-controller="Home"
               asp-action="Index" aria-label="Community Health home">
                <span class="brand-mark">C</span>
                <span class="brand-text">
                    <strong>COMMUNITY HEALTH</strong>
                    <small>MONITORING INITIATIVE</small>
                </span>
            </a>

            <div class="nav-links" id="navigation-links">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Monitoring" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Monitoring" ? "is-current" : "")">
                        Dashboard
                    </a>

                    <a asp-area="Communities" asp-controller="Communities" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Communities" ? "is-current" : "")">
                        Communities
                    </a>

                    <a asp-area="Monitoring" asp-controller="WaterSources" asp-action="Index"
                       class="nav-module-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "WaterSources" ? "is-current" : "")">
                        Water sources
                    </a>

                    <a asp-area="Monitoring" asp-controller="HealthReports" asp-action="Index"
                       class="nav-module-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HealthReports" ? "is-current" : "")">
                        Health reports
                    </a>

                    <a asp-area="Monitoring" asp-controller="Alerts" asp-action="Index"
                       class="nav-module-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alerts" ? "is-current" : "")">
                        Alerts
                    </a>

                    @if (User.IsInRole("Administrator"))
                    {
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Admin" ? "is-current" : "")">
                            User management
                        </a>
                    }
                }
                else
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="mission">
                        Our mission
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="approach">
                        Our approach
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="contact">
                        Contact
                    </a>
                }
            </div>

            <div class="nav-account">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="nav-user">
                        <span class="nav-user-name">
                            @(User.Identity.Name ?? "Account")
                        </span>
                        <span class="nav-user-role">
                            @(User.IsInRole("Administrator") ? "Administrator" : "Field Worker")
                        </span>
                    </div>

                    <form asp-area="Identity" asp-page="/Account/Logout"
                          method="post" class="nav-logout-form">
                        <button type="submit" class="nav-logout-button">
                            Sign out <span>↗</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login"
                       class="nav-login-link">
                        Sign in
                    </a>
                }

                <a asp-area="" asp-controller="Monitoring" asp-action="Index"
                   class="nav-cta glass">
                    Explore platform <span>↗</span>
                </a>
            </div>

            <button class="menu-toggle" type="button"
                    aria-label="Toggle navigation"
                    aria-controls="navigation-links"
                    aria-expanded="false">
                <span></span>
                <span></span>
            </button>

        </nav>
    </header>

    @if (ViewContext.RouteData.Values["area"]?.ToString() == "Monitoring")
    {
        <main class="monitoring-shell">
            @RenderBody()
        </main>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <footer class="site-footer" id="contact">
        <div class="footer-main">
            <div>
                <span class="footer-eyebrow">COMMUNITY HEALTH INITIATIVE</span>
                <h2>Health begins with what we understand.</h2>
            </div>

            <a href="#home" class="footer-top-link">
                Back to top ↑
            </a>
        </div>

        <div class="footer-bottom">
            <span>WATER · HEALTH · COMMUNITY</span>
            <span>ACADEMIC PROJECT · PROTOTYPE</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)



<script>
/* ADAPTIVE-LIQUID-GLASS-SCRIPT */
(() => {
    const navbar = document.querySelector('.liquid-navbar');
    if (!navbar) return;

    const elements = [...navbar.querySelectorAll('a, button')];
    const brand = navbar.querySelector('.brand, .navbar-brand');
    const links = [...navbar.querySelectorAll('a')];
    const cta = links.length ? links[links.length - 1] : null;

    elements.forEach(el => {
        el.classList.remove('adaptive-brand','adaptive-cta','adaptive-nav-link');

        if (el === brand || (brand && el.contains(brand)))
            el.classList.add('adaptive-brand');
        else if (el === cta)
            el.classList.add('adaptive-cta');
        else if (el.tagName === 'A')
            el.classList.add('adaptive-nav-link');
    });

    const parseColor = value => {
        const m = value.match(/rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:\s*[,/]\s*([\d.]+))?\s*\)/i);
        return m ? {r:+m[1],g:+m[2],b:+m[3],a:m[4]===undefined?1:+m[4]} : null;
    };

    const luminance = c => {
        const channels = [c.r,c.g,c.b].map(v => {
            v /= 255;
            return v <= .04045 ? v/12.92 : ((v+.055)/1.055)**2.4;
        });
        return .2126*channels[0]+.7152*channels[1]+.0722*channels[2];
    };

    const previous = new WeakMap();

    function sampleBehind(el) {
        const r = el.getBoundingClientRect();
        const x = r.left+r.width/2;
        const y = r.top+r.height/2;
        const old = el.style.pointerEvents;
        el.style.pointerEvents = 'none';
        const stack = document.elementsFromPoint(x,y);
        el.style.pointerEvents = old;

        for (const item of stack) {
            if (navbar.contains(item)) continue;
            let node = item;
            while (node && node !== document.documentElement) {
                const c = parseColor(getComputedStyle(node).backgroundColor);
                if (c && c.a > .85) return luminance(c);
                node = node.parentElement;
            }
        }
        return .5;
    }

    function update() {
        elements.forEach(el => {
            if (!el.isConnected) return;
            const brightness = sampleBehind(el);
            const old = previous.get(el);
            const dark = old === undefined ? brightness > .48
                : old ? brightness > .40 : brightness > .56;
            previous.set(el,dark);
            el.classList.toggle('behind-dark',!dark);
            el.classList.toggle('behind-light',dark);
        });
    }

    let scheduled = false;
    function schedule() {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
            update();
            scheduled = false;
        });
    }

    window.addEventListener('scroll',schedule,{passive:true});
    window.addEventListener('resize',schedule,{passive:true});
    window.addEventListener('load',schedule);

    new MutationObserver(schedule).observe(document.body,{
        attributes:true,childList:true,subtree:true,
        attributeFilter:['class','style']
    });

    if ('ResizeObserver' in window)
        new ResizeObserver(schedule).observe(navbar);

    update();
})();
</script>
</body>

</html>
