@page
@model Smart_Community_Health_Monitoring_System.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<section class="identity-page">

    <div class="identity-background"></div>
    <div class="identity-overlay"></div>

    <a class="identity-brand" href="/">
        <span class="identity-brand-mark">C</span>
        <span>
            <strong>COMMUNITY HEALTH</strong>
            <small>MONITORING INITIATIVE</small>
        </span>
    </a>

    <div class="identity-content">

        <div class="identity-introduction">
            <span class="identity-eyebrow">
                COMMUNITY HEALTH INITIATIVE
            </span>

            <h1>
                Understanding communities.
                <em>Protecting futures.</em>
            </h1>

            <p>
                A connected platform for environmental monitoring,
                community health information and early-warning capabilities.
            </p>

            <span class="identity-caption">
                WATER · HEALTH · COMMUNITY
            </span>
        </div>

        <div class="identity-panel glass">

            <div class="identity-panel-heading">
                <span class="identity-eyebrow">SECURE ACCESS</span>

                <h2>Welcome <em>back.</em></h2>

                <p>Sign in to access the monitoring platform.</p>
            </div>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">

                <div asp-validation-summary="ModelOnly" class="identity-validation" role="alert"></div>

                <div class="identity-field">
                    <label asp-for="Input.Email">Email address</label>

                    <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="you@example.com"
                           autofocus />

                    <span asp-validation-for="Input.Email"></span>
                </div>

                <div class="identity-field">
                    <label asp-for="Input.Password">Password</label>

                    <div class="identity-password">
                        <input asp-for="Input.Password" id="login-password" autocomplete="current-password"
                               placeholder="Enter your password" />

                        <button type="button" id="toggle-password" aria-label="Show password">
                            Show
                        </button>
                    </div>

                    <span asp-validation-for="Input.Password"></span>
                </div>

                <label class="identity-remember">
                    <input asp-for="Input.RememberMe" />
                    <span>Keep me signed in</span>
                </label>

                <button type="submit" class="identity-submit">
                    Sign in
                    <span>↗</span>
                </button>

            </form>

            <div class="identity-panel-footer">
                <span>AUTHORIZED PERSONNEL ONLY</span>
                <span>COMMUNITY HEALTH INITIATIVE</span>
            </div>

        </div>

    </div>

    <div class="identity-bottom">
        <span>ACADEMIC PROJECT · PROTOTYPE</span>
        <span>SECURE PLATFORM ACCESS</span>
    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const password = document.getElementById("login-password");
        const toggle = document.getElementById("toggle-password");

        toggle.addEventListener("click", () => {
            const isHidden = password.type === "password";

            password.type = isHidden ? "text" : "password";
            toggle.textContent = isHidden ? "Hide" : "Show";
            toggle.setAttribute(
                "aria-label",
                isHidden ? "Hide password" : "Show password"
            );
        });
    </script>
}
