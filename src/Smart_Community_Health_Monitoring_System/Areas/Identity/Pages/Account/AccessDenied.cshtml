@page
@model Smart_Community_Health_Monitoring_System.Areas.Identity.Pages.Account.AccessDeniedModel

@{
    ViewData["Title"] = "Access denied";
}

<section class="identity-page">

    <div class="identity-background"></div>
    <div class="identity-overlay"></div>

    <a class="identity-brand" href="/">
        <span class="identity-brand-mark">C</span>
        <span>
            <strong>COMMUNITY HEALTH</strong>
            <small>MONITORING INITIATIVE</small>
        </span>
    </a>

    <div class="identity-content">

        <div class="identity-introduction">
            <span class="identity-eyebrow">COMMUNITY HEALTH INITIATIVE</span>

            <h1>
                Trust begins with
                <em>responsibility.</em>
            </h1>

            <p>
                Access to sensitive community information is restricted
                to authorized personnel and assigned responsibilities.
            </p>

            <span class="identity-caption">
                WATER · HEALTH · COMMUNITY
            </span>
        </div>

        <div class="identity-panel glass">

            <div class="identity-panel-heading">
                <span class="identity-eyebrow">403 · ACCESS RESTRICTED</span>

                <h2>Not this <em>time.</em></h2>

                <p>
                    Your account does not have permission to access this resource.
                    If you believe this is a mistake, contact your administrator.
                </p>
            </div>

            <a href="/Monitoring" class="identity-submit">
                Return to monitoring
                <span>↗</span>
            </a>

            <div class="identity-panel-footer">
                <span>AUTHORIZED PERSONNEL ONLY</span>
                <span>COMMUNITY HEALTH INITIATIVE</span>
            </div>

        </div>

    </div>

    <div class="identity-bottom">
        <span>ACADEMIC PROJECT · PROTOTYPE</span>
        <span>SECURE PLATFORM ACCESS</span>
    </div>

</section>
