@model IEnumerable<WaterSource>
@{ ViewData["Title"] = "Water Sources"; }
<div class="container py-4">
<h1>Water Sources</h1><p class="text-muted">Registered water points across active communities.</p>
<a class="btn btn-primary mb-3" asp-action="Create">Register source</a>
@if (TempData["SuccessMessage"] is string msg) { <div class="alert alert-success">@msg</div> }
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Source</th><th>Type</th><th>Community</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var x in Model) { <tr><td>@x.Name</td><td>@x.SourceType</td><td>@x.Community.Name</td><td>@(x.IsActive ? "Active" : "Inactive")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Details</a><form class="d-inline" asp-action="ToggleActive" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-secondary">@(x.IsActive ? "Deactivate" : "Activate")</button></form></td></tr> }
</tbody></table></div></div>
